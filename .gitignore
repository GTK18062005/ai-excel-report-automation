# Root gitignore

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.iml

# Backend
backend/target/
backend/*.log

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.env.local

# Docker
.env

# Env files
*.env
.env.*
!.env.example

# Uploaded Excel files
backend/uploads/*
!backend/uploads/.gitkeep

# Local testing & script files
backend/*.py
backend/*.ps1
backend/test-output.txt
backend/testoutput.txt
backend/buildoutput.txt
backend/diagnose_ai.ps1
backend/xl/

# Eclipse / generated backend files
backend/bin/
backend/.classpath
backend/.project
backend/.factorypath
backend/.settings/
*.class

# Local environment & config overrides
backend/application-local.yml
backend/application-local.properties
backend/.env
