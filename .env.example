# Environment Configuration Example
# Copy this to .env or set these environment variables in your environment.

# AI Configuration (Groq / OpenAI compatible)
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# Database Configuration
DB_URL=jdbc:postgresql://localhost:5433/ai_excel_platform
DB_USERNAME=postgres


# Server Port
SERVER_PORT=8081

# JWT Secret (minimum 256-bit secret for HS256)
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes



DB_PASSWORD=your_database_password
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes